#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

appearance_tests = dock_test menubar_test statusbar_view_test wallpaper_test shell_components_test

cursor_tests = surface_test wayland_protocol_test seat_protocol_test xdg_shell_protocol_test sub_surface_test subsurface_output_protocol_test dnd_protocol_test cursor_test input_method_protocol_test

%:
	dh $@

# Build the desktop normally, then explicitly build the protocol/render tests
# that do not need a real GPU. Leave the development-only GPU suite disabled.
override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=OFF -DCUTEFISH_ENABLE_XWAYLAND=ON

override_dh_auto_test:
	dh_auto_configure -- -DBUILD_TESTING=ON -DCUTEFISH_ENABLE_XWAYLAND=ON
	cmake --build obj-$(DEB_HOST_GNU_TYPE) --parallel 4 --target $(cursor_tests) $(appearance_tests) xwayland_test
	ctest --test-dir obj-$(DEB_HOST_GNU_TYPE) --output-on-failure --timeout 90 -R '^(surface_test|wayland_protocol_test|seat_protocol_test|xdg_shell_protocol_test|sub_surface_test|subsurface_output_protocol_test|dnd_protocol_test|cursor_test|input_method_protocol_test)$$'
	CUTEFISH_CAPTURE_DIR=/work/packaging/out/previews ctest --test-dir obj-$(DEB_HOST_GNU_TYPE) --output-on-failure --timeout 90 -R '^(dock_test|menubar_test|statusbar_view_test|wallpaper_test)$$'
	CUTEFISH_CAPTURE_DIR=/work/packaging/out/previews dbus-run-session -- obj-$(DEB_HOST_GNU_TYPE)/tests/shell/shell_components_test --gtest_filter='ShellComponentsTest.CompactDockRendersAtTheUsersIconSize'
	LIBGL_ALWAYS_SOFTWARE=1 EGL_PLATFORM=surfaceless timeout 90 obj-$(DEB_HOST_GNU_TYPE)/tests/xwayland_test --gtest_filter='SurfaceAssociation.*:XwaylandProtocolTest.*:XwaylandTest.RealSoftwareRenderingAndInput'
	dh_auto_configure -- -DBUILD_TESTING=OFF -DCUTEFISH_ENABLE_XWAYLAND=ON
