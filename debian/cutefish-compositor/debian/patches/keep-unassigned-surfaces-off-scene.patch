+    // A client can commit a cursor image before set_cursor is accepted (or
+    // without ever using it). Keep unassigned surfaces off the scene so their
+    // buffers cannot appear as stationary desktop content or receive input.
+    // The window, subsurface, cursor and drag roles attach their own nodes.
+    surface->reparentNode(nullptr);
     if (auto* server = Server::serverForDisplay(wl_client_get_display(client))) {
