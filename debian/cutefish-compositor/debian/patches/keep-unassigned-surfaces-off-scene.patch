+TEST_F(SeatProtocolTest, UnassignedCursorStaysOffSceneUntilAccepted)
+{
+    run([&](Client& c) {
+        c.getPointer();
+        wl_surface* target = c.makeSurface({200, 200});
+        wl_surface* cursor = c.makeSurface({24, 24});
+        c.sync();
+
+        // Check the renderer, not just role bookkeeping: the old compositor
+        // drew this buffer at its cascade position before set_cursor.
+        auto expectCursorDrawn = [&](bool drawn) {
+            testsupport::FakeRenderer renderer;
+            compositor.updateTextures(renderer);
+            auto* texture = compositor.surfaces()[1]->node()->texture();
+            ASSERT_NE(nullptr, texture);
+            scene.root()->render(renderer);
+            EXPECT_EQ(drawn ? 1 : 0,
+                      std::count_if(renderer.calls.begin(), renderer.calls.end(),
+                                    [texture](const auto& call) { return call.texture == texture; }));
+        };
+
+        check([&] {
+            EXPECT_EQ(nullptr, compositor.surfaces()[0]->node()->parent());
+            EXPECT_EQ(nullptr, compositor.surfaces()[1]->node()->parent());
+            expectCursorDrawn(false);
+            seat.onPointerMotion(at(1), {50, 50});
+        });
+        c.sync();
+        EXPECT_TRUE(c.observed.pointerEvents.empty());
+
+        // A rejected request must not make the buffered image visible.
+        wl_pointer_set_cursor(c.pointer, 0, cursor, 6, 8);
+        c.sync();
+        check([&] {
+            EXPECT_FALSE(seat.hasClientCursorRequest());
+            expectCursorDrawn(false);
+            place(0, {0, 0});
+            seat.onPointerMotion(at(2), {50, 50});
+        });
+        c.sync();
+        // This point is also inside the unused image's old cascade rectangle.
+        EXPECT_EQ(target, c.observed.enterSurface);
+        ASSERT_NE(0u, c.observed.enterSerial);
+
+        wl_pointer_set_cursor(c.pointer, c.observed.enterSerial, cursor, 6, 8);
+        c.sync();
+        check([&] {
+            EXPECT_EQ(cursorContainer, compositor.surfaces()[1]->node()->parent());
+            EXPECT_EQ(base::Point(44, 42), compositor.surfaces()[1]->position());
+            expectCursorDrawn(true);
+            seat.onPointerMotion(at(3), {100, 100});
+            EXPECT_EQ(base::Point(94, 92), compositor.surfaces()[1]->position());
+            expectCursorDrawn(true);
+        });
+
+        wl_pointer_set_cursor(c.pointer, c.observed.enterSerial, nullptr, 0, 0);
+        wl_surface_commit(cursor);
+        c.sync();
+        check([&] {
+            EXPECT_EQ(nullptr, compositor.surfaces()[1]->node()->parent());
+            expectCursorDrawn(false);
+        });
+    });
+}
