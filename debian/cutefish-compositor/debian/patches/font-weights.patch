Description: Follow saved font weights and live appearance changes in the desktop shell.
Author: yeyebbc <19569343+yeyebbc@users.noreply.github.com>
Forwarded: no

--- a/src/shell/shell.cpp
+++ b/src/shell/shell.cpp
@@ -11,8 +11,9 @@

 #include "base/dbus.h"
 #include "base/settings.h"
 #include "core/preferences.h"
+#include "cutefish/appearance/appearance.h"
 #include "decoration/decoration_theme.h"
 #include "display/display_manager.h"
 #include "shell/common/app_launcher.h"
