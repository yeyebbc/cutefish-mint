@@ -44,8 +45,21 @@
                                                            : settingsPath);
         m_iconTheme = settings.stringValue("Appearance/IconTheme", "Cutefish");
         m_fontFamily = settings.stringValue("Appearance/Font", "");
         m_fontPointSize = settings.doubleValue("Appearance/FontSize", 9);
+        m_fixedFontFamily = settings.stringValue("Appearance/FixedFont", "Noto Mono");
+        m_fontWeight = int(std::clamp<int64_t>(settings.intValue("Appearance/FontWeight", 400), 100, 900));
+        m_fixedFontWeight = int(std::clamp<int64_t>(settings.intValue("Appearance/FixedFontWeight", 400), 100, 900));
+        m_appearanceChanged = m_appearance.changed.connect([this] {
+            if (!m_appearance.isAvailable())
+                return;
+            m_fontFamily = m_appearance.fontFamily();
+            m_fixedFontFamily = m_appearance.fixedFontFamily();
+            m_fontPointSize = m_appearance.fontPointSize();
+            m_fontWeight = m_appearance.fontWeight();
+            m_fixedFontWeight = m_appearance.fixedFontWeight();
+            apply();
+        });
         if (m_theme)
             m_theme->addObserver(this);
         apply();
     }
@@ -71,16 +85,24 @@
         if (accent >= 0 && accent < int(std::size(kAccents)))
             theme.highlight = kAccents[accent];
         theme.iconTheme = m_iconTheme;
         theme.fontFamily = m_fontFamily;
+        theme.fixedFontFamily = m_fixedFontFamily;
