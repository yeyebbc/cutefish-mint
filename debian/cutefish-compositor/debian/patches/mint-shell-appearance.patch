+        bar->light = light;
+        view->barChanged();
+        frame();
+        const ui::Image image = bar->window->window()->grab();
+        int ink = 0;
+        for (int y = 0; y < image.height(); ++y)
+            for (int x = 0; x < 46 && x < image.width(); ++x)
+                ink += image.pixel(x, y).a != 0;
+        EXPECT_GT(ink, 10);
+        EXPECT_TRUE(saveAppearanceCapture(image, light ? "menu-light-ink.png" : "menu-dark-ink.png"));
