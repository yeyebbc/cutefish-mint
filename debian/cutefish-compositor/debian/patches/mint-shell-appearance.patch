+++ b/tests/shell/appearance_capture.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdlib>
+#include <filesystem>
+#include <string>
+#include "ui/image.h"
+
+// Window::grab currently returns premultiplied pixels for translucent windows,
+// while Image::savePng expects straight alpha. Convert only the test capture.
+inline bool saveAppearanceCapture(cutefish::ui::Image image, const std::string& name)
+{
+    const char* output = std::getenv("CUTEFISH_CAPTURE_DIR");
+    if (!output)
+        return true;
+    for (int y = 0; y < image.height(); ++y) {
+        for (int x = 0; x < image.width(); ++x) {
+            auto color = image.pixel(x, y);
+            if (color.a > 0 && color.a < 255) {
+                color.r = std::min(255, (color.r * 255 + color.a / 2) / color.a);
+                color.g = std::min(255, (color.g * 255 + color.a / 2) / color.a);
+                color.b = std::min(255, (color.b * 255 + color.a / 2) / color.a);
+                image.setPixel(x, y, color);
+            }
+        }
+    }
+    std::filesystem::create_directories(output);
+    return image.savePng(std::string(output) + '/' + name);
+}
