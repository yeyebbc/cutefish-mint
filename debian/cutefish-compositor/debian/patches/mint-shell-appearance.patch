+TEST_F(DockTest, CompactSpacingKeepsIconSizeAndCanBeDisabled)
+{
+    start("[Dock]\nIconSize=37\nCompactSpacing=false\n");
+    EXPECT_FALSE(dock->settings().compactSpacing());
+    EXPECT_EQ(dock->settings().iconSize(), 37);
+    for (int size : {24, 37, 54, 96}) {
+        const auto compact = shell::DockMetrics::forIconSize(size, true);
+        const auto upstream = shell::DockMetrics::forIconSize(size);
+        EXPECT_EQ(compact.iconSize, upstream.iconSize);
+        EXPECT_LT(compact.length(8), upstream.length(8));
+        EXPECT_LT(compact.thickness(), upstream.thickness());
+        EXPECT_GE(compact.pitch(), size);
+        EXPECT_GT(compact.dotAreaSize(), compact.dotSize);
+    }
+}
