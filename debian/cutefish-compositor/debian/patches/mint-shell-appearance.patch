+TEST_F(FlatStatusBarViewTest, UniformTintFollowsAppearanceAndIgnoresWallpaperBrightness)
+{
+    const ui::Theme saved = ui::Theme::current();
+    for (bool dark : {false, true}) {
+        ui::Theme::setCurrent(dark ? ui::Theme::dark() : ui::Theme::light());
+        frame();
+        test::processPendingEvents();
+        frame();
+        bar->backdrop().setColor(dark ? ui::Color::rgb(0xFFFFFF) : ui::Color::rgb(0x000000));
+        EXPECT_EQ(bar->lightContents(), dark);
+        const ui::Color expected = dark ? ui::Color {28, 28, 30, 220} : ui::Color {246, 246, 246, 210};
+        const ui::Image image = bar->window()->window()->grab();
+        const ui::Color actual = image.pixel(5, 2);
+        // grab() retains premultiplied RGB for a translucent window.
+        EXPECT_NEAR(actual.r, expected.r * expected.a / 255.0, 1);
+        EXPECT_NEAR(actual.g, expected.g * expected.a / 255.0, 1);
+        EXPECT_NEAR(actual.b, expected.b * expected.a / 255.0, 1);
+        EXPECT_EQ(actual.a, expected.a);
+        EXPECT_EQ(actual, image.pixel(5, image.height() - 3));
+        EXPECT_TRUE(saveAppearanceCapture(image, dark ? "bar-dark.png" : "bar-light.png"));
+    }
+    ui::Theme::setCurrent(saved);
+}
