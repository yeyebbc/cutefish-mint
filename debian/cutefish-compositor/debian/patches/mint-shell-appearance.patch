+TEST_F(MenuBarTest, MissingAccountPhotoShowsTheLogoInBothAppearances)
+{
+    view->setUserIcon(directory.filePath("missing-face.png"));
+    ui::View* logo = nullptr;
+    ui::ImageView* avatar = nullptr;
+    for (const auto& child : view->entry(0)->children()) {
+        if (child->name() == "menu-logo")
+            logo = child.get();
+        if (auto* image = dynamic_cast<ui::ImageView*>(child.get()))
