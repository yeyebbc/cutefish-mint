#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

%:
	dh $@

# The Skia build looks for GN in its own bin/; the package builds with the
# system's.
override_dh_auto_configure:
	ln -sf /usr/bin/gn third_party/skia/bin/gn
	dh_auto_configure -- -DBUILD_TESTING=OFF

override_dh_auto_clean:
	dh_auto_clean
	rm -f third_party/skia/bin/gn

override_dh_auto_test:
	dh_auto_configure -- -DBUILD_TESTING=ON
	cmake --build obj-$(DEB_HOST_GNU_TYPE) --parallel 4 --target cutefish-font-weight-test
	dbus-run-session -- obj-$(DEB_HOST_GNU_TYPE)/tests/cutefish-font-weight-test
	dh_auto_configure -- -DBUILD_TESTING=OFF
