--- /dev/null
+++ b/tests/font_weight_test.cpp
@@ -0,0 +1,62 @@
+#include <algorithm>
+#include <gtest/gtest.h>
+#include "ui/application.h"
+#include "ui/label.h"
+#include "ui/text_layout.h"
+#include "ui/theme.h"
+#include "ui/window.h"
+
+using namespace cutefish::ui;
+
+class FontWeightTest : public testing::Test {
+protected:
+    Theme saved = Theme::current();
+    void TearDown() override { Theme::setCurrent(saved); }
+};
+
+TEST_F(FontWeightTest, NativeLabelsRepaintAndExplicitEmphasisIsPreserved)
+{
+    Theme theme = Theme::light();
+    theme.fontFamily = "DejaVu Sans";
+    theme.fontPointSize = 20;
+    Theme::setCurrent(theme);
+    Window window;
+    window.resize({360, 50});
+    auto label = std::make_unique<Label>("Readable font weight");
+    Label* textLabel = label.get();
+    window.setContentView(std::move(label));
+    window.show();
+    const Image regular = window.grab();
+    theme.fontWeight = 700;
+    Theme::setCurrent(theme);
+    const Image bold = window.grab();
+    ASSERT_EQ(regular.width(), bold.width());
+    ASSERT_EQ(regular.height(), bold.height());
+    EXPECT_FALSE(std::equal(regular.bits(), regular.bits() + regular.width() * regular.height(), bold.bits()));
+    textLabel->setWeight(600);
+    const Image emphasis = window.grab();
+    theme.fontWeight = 300;
+    Theme::setCurrent(theme);
+    const Image lighterDefault = window.grab();
+    EXPECT_TRUE(std::equal(emphasis.bits(), emphasis.bits() + emphasis.width() * emphasis.height(),
+                           lighterDefault.bits()));
+}
+
+TEST_F(FontWeightTest, FixedWeightIsIndependentAndReachesGlyphMetrics)
+{
+    Theme theme = Theme::light();
+    theme.fontFamily = "DejaVu Sans";
+    theme.fixedFontFamily = "DejaVu Sans Mono";
+    theme.fontWeight = 300;
+    theme.fixedFontWeight = 700;
+    Theme::setCurrent(theme);
+    const FontSpec fixed = systemFixedFont();
+    EXPECT_EQ(fixed.weight, 700);
+    EXPECT_EQ(fixed.family, "DejaVu Sans Mono");
+    EXPECT_EQ(Theme::current().fontWeight, 300);
+    TextLayout layout("mmWW0123", fixed);
+    layout.beginLayout();
+    ASSERT_GE(layout.createLine(1000, {}), 0);
+    layout.endLayout();
+    EXPECT_NEAR(layout.maximumWidth(), FontMetrics(fixed).horizontalAdvanceF("mmWW0123"), 1);
+}
