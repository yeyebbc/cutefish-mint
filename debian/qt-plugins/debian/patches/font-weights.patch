+void PlatformThemeTest::fontWeightsAreIndependentAndReload()
+{
+    QVERIFY(writeSettings("[Appearance]\nFontWeight=400\nFixedFontWeight=400\n"));
+    HintsSettings hints;
+    QCoreApplication::processEvents();
+    QSignalSpy general(&hints, &HintsSettings::systemFontChanged);
+    QSignalSpy fixed(&hints, &HintsSettings::systemFixedFontChanged);
+    QVERIFY(writeSettings("[Appearance]\nFontWeight=700\nFixedFontWeight=500\n"));
+    QTRY_COMPARE(hints.systemFontWeight(), 700);
+    QTRY_COMPARE(hints.systemFixedFontWeight(), 500);
+    QTRY_VERIFY(general.count() > 0);
+    QTRY_VERIFY(fixed.count() > 0);
 }

