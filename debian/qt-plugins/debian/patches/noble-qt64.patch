 namespace Cutefish {
+
+static void *waylandResource(const QByteArray &name)
+{
+    if (!qGuiApp || !QGuiApplication::platformName().startsWith(QLatin1String("wayland")))
+        return nullptr;
+    auto *native = qGuiApp->platformNativeInterface();
+    return native ? native->nativeResourceForIntegration(name) : nullptr;
+}
 
