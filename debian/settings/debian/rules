#!/usr/bin/make -f
include /usr/share/dpkg/architecture.mk

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=OFF

override_dh_auto_test:
	dh_auto_configure -- -DBUILD_TESTING=ON
	cmake --build obj-$(DEB_HOST_GNU_TYPE) --parallel 4 --target settings-ui-tests
	CUTEFISH_CAPTURE_DIR=/work/packaging/out/previews dbus-run-session --config-file=tests/ui/dbus-session.conf -- obj-$(DEB_HOST_GNU_TYPE)/tests/ui/settings-ui-tests --gtest_filter='Fonts.*'
	dh_auto_configure -- -DBUILD_TESTING=OFF
