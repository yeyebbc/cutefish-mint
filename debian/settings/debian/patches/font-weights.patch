+++ b/tests/ui/fonts_test.cpp
@@ -0,0 +1,79 @@
+#include <atomic>
+#include <cstdlib>
+#include <filesystem>
+#include <gtest/gtest.h>
+#include "input_test_support.h"
+#include "cutefish/appearance/appearance.h"
+#include "widgets/rowcombobox.h"
+#include "ui/theme.h"
+#include "window/settingswindow.h"
+
+using namespace cutefish;
+using namespace settings::testing;
+
+TEST(Fonts, EachWeightRoundTripsThroughTheServiceAndThePage)
+{
+    std::atomic<int32_t> general{400}, fixed{400};
+    ServiceThread service("org.cutefish.Services", [&](base::dbus::Connection& bus) {
+        auto object = std::make_shared<base::dbus::Object>(&bus, "/org/cutefish/Services/Appearance",
+                                                          "org.cutefish.Services.Appearance");
+        object->addProperty("systemFont", [] { return std::string("DejaVu Sans"); });
+        object->addProperty("systemFixedFont", [] { return std::string("DejaVu Sans Mono"); });
+        object->addProperty("systemFontPointSize", [] { return 10.0; });
+        object->addProperty("systemFontWeight", [&] { return general.load(); });
+        object->addProperty("systemFixedFontWeight", [&] { return fixed.load(); });
+        object->addSignal("systemFontWeightChanged", "");
+        object->addSignal("systemFixedFontWeightChanged", "");
+        auto* raw = object.get();
+        object->addMethod("setSystemFontWeight", [&, raw](int32_t weight) {
+            general = weight; raw->emitSignal("systemFontWeightChanged");
+        });
+        object->addMethod("setSystemFixedFontWeight", [&, raw](int32_t weight) {
+            fixed = weight; raw->emitSignal("systemFixedFontWeightChanged");
+        });
+        object->publish();
+        return object;
+    });
+    ASSERT_TRUE(service.start());
+    appearance::Appearance observer;
+    ASSERT_TRUE(waitFor([&] { return observer.isAvailable(); }));
+    settings::SettingsWindow settingsWindow;
+    auto& window = settingsWindow.window();
+    window.resize({900, 820});
+    settingsWindow.switchToPage("appearance");
+    settingsWindow.pushPage("fonts");
+    settingsWindow.reveal();
+    window.grab();
+    auto* generalBox = findView<settings::RowComboBox>(window.contentView(), "general-font-weight");
+    auto* fixedBox = findView<settings::RowComboBox>(window.contentView(), "fixed-font-weight");
+    ASSERT_NE(generalBox, nullptr);
+    ASSERT_NE(fixedBox, nullptr);
+    EXPECT_EQ(generalBox->currentIndex(), 3);
+    EXPECT_EQ(fixedBox->currentIndex(), 3);
+    generalBox->onActivated(6);
+    ASSERT_TRUE(waitFor([&] { return observer.fontWeight() == 700 && generalBox->currentIndex() == 6; }));
+    EXPECT_EQ(observer.fixedFontWeight(), 400);
+    fixedBox->onActivated(4);
+    ASSERT_TRUE(waitFor([&] { return observer.fixedFontWeight() == 500 && fixedBox->currentIndex() == 4; }));
+    EXPECT_EQ(observer.fontWeight(), 700);
+    if (const char* directory = std::getenv("CUTEFISH_CAPTURE_DIR")) {
+        std::filesystem::create_directories(directory);
+        const ui::Theme saved = ui::Theme::current();
+        for (bool dark : {false, true}) {
+            ui::Theme theme = dark ? ui::Theme::dark() : ui::Theme::light();
+            theme.fontFamily = "DejaVu Sans";
+            theme.fixedFontFamily = "DejaVu Sans Mono";
+            theme.fontWeight = observer.fontWeight();
+            theme.fixedFontWeight = observer.fixedFontWeight();
+            theme.fontPointSize = 10;
+            ui::Theme::setCurrent(theme);
+            for (double scale : {1.0, 2.0}) {
+                window.setScale(scale);
+                const std::string path = std::string(directory) + "/fonts-" + (dark ? "dark" : "light")
+                        + (scale == 1 ? "@1.png" : "@2.png");
+                EXPECT_TRUE(window.grab().savePng(path));
+            }
+        }
+        ui::Theme::setCurrent(saved);
+    }
+}
