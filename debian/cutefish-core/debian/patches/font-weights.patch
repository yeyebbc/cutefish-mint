+
+int ThemeManager::systemFontWeight() const
+{
+    return int(std::clamp<int64_t>(m_settings.intValue("Appearance/FontWeight", 400), 100, 900));
+}
+
+void ThemeManager::setSystemFontWeight(int weight)
+{
+    if (weight < 100 || weight > 900 || weight == systemFontWeight())
+        return;
+    write("FontWeight", weight);
+    updateGtk3Config();
+    emitSignal("systemFontWeightChanged");
+}
+
+int ThemeManager::systemFixedFontWeight() const
+{
+    return int(std::clamp<int64_t>(m_settings.intValue("Appearance/FixedFontWeight", 400), 100, 900));
+}
+
+void ThemeManager::setSystemFixedFontWeight(int weight)
+{
+    if (weight < 100 || weight > 900 || weight == systemFixedFontWeight())
+        return;
+    write("FixedFontWeight", weight);
+    updateGtk3Config();
+    emitSignal("systemFixedFontWeightChanged");
 }

