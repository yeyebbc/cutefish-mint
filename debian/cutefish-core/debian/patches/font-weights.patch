+// Pango's font description syntax. An omitted style retains the old regular default.
+static std::string fontDescription(const std::string &family, double size, int weight)
+{
+    static constexpr const char *styles[] = {
+        " Thin", " Ultra-Light", " Light", "", " Medium", " Semi-Bold", " Bold", " Ultra-Bold", " Heavy",
+    };
+    return family + styles[std::clamp((weight + 50) / 100, 1, 9) - 1] + ' ' + number(size, 'g', -1);
+}
